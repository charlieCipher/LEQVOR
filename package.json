{
  "name": "leqvor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "check:build": "node scripts/check-build.mjs",
    "verify": "npm run check:dependencies && npm run lint -- --max-warnings=0 && npm test && npm run check:database && npm run check:restore && npm run build && npm run check:build",
    "preview": "vite preview",
    "check:dependencies": "npm audit --audit-level=low",
    "check:database": "node scripts/check-database.mjs",
    "check:restore": "node scripts/check-restore.mjs",
    "check:release-config": "node scripts/check-release-config.mjs",
    "build:release": "node scripts/build-release.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "prepare:release": "npm run verify && npm run check:release-config && node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "@scure/bip39": "2.0.1",
    "@supabase/supabase-js": "2.100.1",
    "crypto-js": "4.2.0",
    "jspdf": "4.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.39.4",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "axe-core": "4.13.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "jsdom": "29.1.1",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
